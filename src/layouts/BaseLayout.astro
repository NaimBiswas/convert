---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;
  robots?: string;
  schema?: object;
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title, description, image = '/og-image.png',
  keywords, robots = 'index, follow',
  schema, breadcrumbs,
} = Astro.props;
const siteName = 'Data Converter';
const url = Astro.url;

const pageSchema = schema || {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: siteName,
  url: 'https://metadataconverter.com',
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {siteName}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={robots} />

    <link rel="canonical" href={url} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5712552452630675" crossorigin="anonymous"></script>
    <script async custom-element="amp-auto-ads" src="https://cdn.ampproject.org/v0/amp-auto-ads-0.1.js"></script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CH6QGF1ES3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CH6QGF1ES3');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/images/icons/favicon.png" />
    <link rel="shortcut icon" href="/images/icons/favicon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    {breadcrumbs && <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.name,
        item: `https://metadataconverter.com${item.url}`,
      })),
    })} />}
  </head>
  <body>
    <amp-auto-ads type="adsense" data-ad-client="ca-pub-5712552452630675"></amp-auto-ads>
    <div class="app">
      <Header />
      <div class="main"><slot /></div>
      <Footer />
    </div>
    <script>
      import { initTheme } from '../lib/theme';
      initTheme();
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #F7F5F0;
    --surface: #FFFFFF;
    --surface-hover: #FBF9F5;
    --surface-active: #F3F0EA;
    --border: #E6E2DA;
    --border-focus: #C8921E;
    --primary: #C8921E;
    --primary-hover: #DBA62E;
    --primary-glow: rgba(200, 146, 30, 0.12);
    --secondary: #7C5CBF;
    --secondary-glow: rgba(124, 92, 191, 0.08);
    --text: #1E1C18;
    --text-secondary: #6B665E;
    --text-muted: #A6A098;
    --success: #5B9E6E;
    --error: #C45A5A;
    --code-bg: #F0EEE8;
    --radius: 10px;
    --radius-sm: 6px;
    --transition: 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :root.dark {
    --bg: #0D0D12;
    --surface: #16161D;
    --surface-hover: #1E1E28;
    --surface-active: #252530;
    --border: #2A2A36;
    --border-focus: #F59E0B;
    --primary: #F59E0B;
    --primary-hover: #FBBF24;
    --primary-glow: rgba(245, 158, 11, 0.15);
    --secondary: #8B5CF6;
    --secondary-glow: rgba(139, 92, 246, 0.1);
    --text: #F1F1F5;
    --text-secondary: #94949C;
    --text-muted: #5C5C66;
    --success: #10B981;
    --error: #EF4444;
    --code-bg: #111118;
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    transition: background var(--transition), color var(--transition);
  }

  .app { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; min-height: 100vh; }
  .app > .main { flex: 1; }

  @media (max-width: 640px) {
    .app { padding: 0 16px; }
  }
</style>
