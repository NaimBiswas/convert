---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;
  robots?: string;
  schema?: object;
  breadcrumbs?: { name: string; url: string }[];
  article?: { headline: string; datePublished: string; description: string };
}

const siteUrl = 'https://metadataconverter.com';
const {
  title, description, image = `${siteUrl}/og-image.png`,
  keywords, robots = 'index, follow',
  schema, breadcrumbs, article,
} = Astro.props;
const siteName = 'Data Converter';
const url = Astro.url;

const absImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

const pageSchema = schema || {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: siteName,
  url: siteUrl,
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  browserRequirements: 'Requires JavaScript',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="monetag" content="df2087e951655c11b46b77bab9d2b7e4" />
    <script src="https://quge5.com/88/tag.min.js" data-zone="264226" async data-cfasync="false"></script>
    <title>{title} — {siteName}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={robots} />

    <link rel="canonical" href={url} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absImage} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absImage} />

    <script is:inline>
      function loadScript(src, attrs = {}) {
        const s = document.createElement('script');
        s.src = src;
        s.async = true;
        Object.entries(attrs).forEach(([k,v]) => s.setAttribute(k,v));
        document.head.appendChild(s);
      }
      function loadAnalytics() {
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        loadScript('https://www.googletagmanager.com/gtag/js?id=G-CH6QGF1ES3');
        gtag('js', new Date());
        gtag('config', 'G-CH6QGF1ES3');
        loadScript('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5712552452630675', {crossorigin:'anonymous'});
        loadScript('https://cdn.ampproject.org/v0/amp-auto-ads-0.1.js', {'custom-element':'amp-auto-ads'});
      }
      if (localStorage.getItem('cookieConsent') === 'accepted') {
        loadAnalytics();
      } else {
        document.addEventListener('DOMContentLoaded', () => {
          const banner = document.getElementById('cookie-banner');
          if (banner) banner.style.display = 'flex';
        });
      }
      window.acceptCookies = function() {
        localStorage.setItem('cookieConsent', 'accepted');
        const banner = document.getElementById('cookie-banner');
        if (banner) banner.style.display = 'none';
        loadAnalytics();
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/images/icons/favicon.png" />
    <link rel="shortcut icon" href="/images/icons/favicon.png" />
    <link rel="apple-touch-icon" href="/images/icons/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1E1C18" />

    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    {breadcrumbs && <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.name,
        item: `${siteUrl}${item.url}`,
      })),
    })} />}
    {article && <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: article.headline,
      description: article.description,
      datePublished: article.datePublished,
      author: { '@type': 'Person', name: 'Naim Biswas', url: 'https://github.com/NaimBiswas' },
      publisher: { '@type': 'Organization', name: 'Data Converter', url: siteUrl },
    })} />}
  </head>
  <body>
    <amp-auto-ads type="adsense" data-ad-client="ca-pub-5712552452630675"></amp-auto-ads>
    <div id="cookie-banner" class="cookie-banner" style="display:none">
      <span>This site uses cookies for analytics and ads. <a href="/cookies">Learn more</a>.</span>
      <button onclick="acceptCookies()">Got it</button>
    </div>
    <div class="app">
      <Header />
      <div class="main"><slot /></div>
      <Footer />
    </div>
    <script>
      import { initTheme } from '../lib/theme';
      initTheme();
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #F7F5F0;
    --surface: #FFFFFF;
    --surface-hover: #FBF9F5;
    --surface-active: #F3F0EA;
    --border: #E6E2DA;
    --border-focus: #C8921E;
    --primary: #C8921E;
    --primary-hover: #DBA62E;
    --primary-glow: rgba(200, 146, 30, 0.12);
    --secondary: #7C5CBF;
    --secondary-glow: rgba(124, 92, 191, 0.08);
    --text: #1E1C18;
    --text-secondary: #6B665E;
    --text-muted: #A6A098;
    --success: #5B9E6E;
    --error: #C45A5A;
    --code-bg: #F0EEE8;
    --radius: 10px;
    --radius-sm: 6px;
    --transition: 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  :root.dark {
    --bg: #0D0D12;
    --surface: #16161D;
    --surface-hover: #1E1E28;
    --surface-active: #252530;
    --border: #2A2A36;
    --border-focus: #F59E0B;
    --primary: #F59E0B;
    --primary-hover: #FBBF24;
    --primary-glow: rgba(245, 158, 11, 0.15);
    --secondary: #8B5CF6;
    --secondary-glow: rgba(139, 92, 246, 0.1);
    --text: #F1F1F5;
    --text-secondary: #94949C;
    --text-muted: #5C5C66;
    --success: #10B981;
    --error: #EF4444;
    --code-bg: #111118;
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    transition: background var(--transition), color var(--transition);
  }

  .app { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; flex-direction: column; min-height: 100vh; }
  .app > .main { flex: 1; }

  .cookie-banner {
    position: fixed; bottom: 0; left: 0; right: 0;
    display: flex; align-items: center; justify-content: center;
    gap: 16px; padding: 12px 24px;
    background: var(--surface); border-top: 1px solid var(--border);
    font-size: 13px; color: var(--text-secondary); z-index: 1000;
    box-shadow: 0 -2px 12px rgba(0,0,0,0.08);
  }
  .cookie-banner a { color: var(--primary); text-decoration: none; }
  .cookie-banner a:hover { text-decoration: underline; }
  .cookie-banner button {
    padding: 6px 16px; border-radius: 100px; border: none;
    background: var(--primary); color: #fff; font-size: 13px;
    font-weight: 500; cursor: pointer; white-space: nowrap;
  }
  .cookie-banner button:hover { background: var(--primary-hover); }

  @media (max-width: 640px) {
    .app { padding: 0 16px; }
    .cookie-banner { flex-direction: column; text-align: center; gap: 10px; padding: 12px 16px; }
  }
</style>
