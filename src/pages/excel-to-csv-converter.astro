---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConverterBar from '../components/ConverterBar.astro';
import InputPanel from '../components/InputPanel.astro';
import PreviewTable from '../components/PreviewTable.astro';
---

<BaseLayout title="Excel to CSV Converter — Convert XLSX to CSV Online Free" description="Convert Excel (.xlsx) to CSV online free. Upload your spreadsheet and download as plain CSV. Multi-sheet support, 50 MB limit, browser-based processing." keywords="excel to csv, xlsx to csv, excel to csv converter, convert excel to csv, xlsx to csv online" breadcrumbs={[{name:'Home',url:'/'},{name:'Excel to CSV Converter',url:'/excel-to-csv-converter'}]}>
  <main class="landing">
    <section class="landing-hero">
      <h1>Excel to CSV Converter</h1>
      <p class="landing-desc">Convert your Excel spreadsheets to plain CSV format — fast, free, and private. Ideal for migrating data between systems, importing into databases, or preparing files for data analysis tools.</p>
    </section>

    <ConverterBar from="Excel (XLSX)" to="CSV" />
    <InputPanel />
    <PreviewTable />

    <section class="landing-content">
      <h2>Why Convert Excel to CSV?</h2>
      <p>CSV is the simplest, most universal data format — every spreadsheet app, database, and data tool can read it. Converting XLSX to CSV removes formatting, macros, and proprietary structures, leaving you with clean, portable tabular data.</p>

      <h2>How to Convert Excel to CSV</h2>
      <ol>
        <li>Select <strong>Excel (XLSX)</strong> as source and <strong>CSV</strong> as target format</li>
        <li>Upload your <code>.xlsx</code> file via drag & drop or browse</li>
        <li>Select a sheet if the workbook contains multiple sheets</li>
        <li>Click <strong>Convert</strong> or press <kbd>Ctrl+Enter</kbd></li>
        <li>Preview and download as CSV</li>
      </ol>

      <h2>Features</h2>
      <ul>
        <li>Multi-sheet Excel workbooks supported</li>
        <li>Proper CSV quoting — handles commas and line breaks in cells</li>
        <li>Header row preserved from Excel column names</li>
        <li>Files up to 50 MB supported</li>
        <li>No formatting or metadata carried over — clean data only</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .landing { max-width: 1000px; margin: 0 auto; }
  .landing-hero { text-align: center; padding: 40px 16px 24px; }
  .landing-hero h1 { font-size: 32px; font-weight: 600; letter-spacing: -0.5px; margin-bottom: 12px; }
  .landing-desc { font-size: 15px; color: var(--text-secondary); max-width: 640px; margin: 0 auto; line-height: 1.7; }
  .landing-content { padding: 40px 16px 60px; max-width: 720px; margin: 0 auto; }
  .landing-content h2 { font-size: 22px; font-weight: 600; margin: 32px 0 12px; letter-spacing: -0.3px; }
  .landing-content p { font-size: 15px; line-height: 1.7; color: var(--text-secondary); margin-bottom: 12px; }
  .landing-content ul, .landing-content ol { padding-left: 20px; margin-bottom: 12px; }
  .landing-content li { font-size: 14px; line-height: 1.8; color: var(--text-secondary); }
  .landing-content kbd { font-family: 'JetBrains Mono', monospace; font-size: 12px; padding: 2px 7px; border-radius: 5px; border: 1px solid var(--border); background: var(--surface); }
  @media (max-width: 640px) {
    .landing-hero h1 { font-size: 24px; }
    .landing-hero { padding: 24px 16px 16px; }
    .landing-content h2 { font-size: 18px; }
  }
</style>
