---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ConverterBar from '../components/ConverterBar.astro';
import InputPanel from '../components/InputPanel.astro';
import PreviewTable from '../components/PreviewTable.astro';
---

<BaseLayout title="Free Online Data Converter — JSON, CSV, Excel, XML, YAML Tool" description="Convert JSON, CSV, Excel, XML, YAML, HTML, Markdown, and more — all in your browser. No uploads, 100% private." keywords="data converter, JSON to CSV, Excel to JSON, CSV to JSON, XML to JSON, free online tool, format converter" robots="index, follow">
  <Hero />
  <ConverterBar />
  <InputPanel />
  <PreviewTable />

  <section class="use-cases">
    <div class="section-header">
      <h2>Why Use Data Converter?</h2>
      <p>Everything runs client-side — your files never leave your device. No sign-ups, no limits, completely free.</p>
    </div>
    <div class="use-case-grid">
      <div class="use-case-card">
        <div class="use-case-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
        </div>
        <h3>API Development</h3>
        <p>Convert JSON API responses to CSV for spreadsheet analysis, or transform CSV data into JSON for API testing.</p>
      </div>
      <div class="use-case-card">
        <div class="use-case-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        </div>
        <h3>Database Migrations</h3>
        <p>Convert Excel sheets or CSV exports to JSON or XML for import into MongoDB, PostgreSQL, Firebase, and more.</p>
      </div>
      <div class="use-case-card">
        <div class="use-case-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </div>
        <h3>Config Management</h3>
        <p>Translate YAML config files to JSON for JavaScript apps, or convert JSON configs to YAML for Docker and Kubernetes.</p>
      </div>
      <div class="use-case-card">
        <div class="use-case-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <h3>Data Reporting</h3>
        <p>Convert JSON or XML data into formatted HTML tables or Markdown for documentation, reports, and presentations.</p>
      </div>
      <div class="use-case-card">
        <div class="use-case-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </div>
        <h3>Spreadsheet Processing</h3>
        <p>Upload Excel files, edit cell values, filter rows, and export as CSV, JSON, or PDF — all in your browser.</p>
      </div>
    </div>
  </section>

  <section class="format-table">
    <div class="section-header">
      <h2>Supported Conversions</h2>
      <p>Every format pair you need, one click away</p>
    </div>
    <div class="format-grid">
      <div class="format-card">
        <span class="format-label">JSON</span>
        <span class="format-arrow">→</span>
        <div class="format-targets">
          <span>CSV</span><span>Excel</span><span>XML</span><span>YAML</span><span>HTML</span><span>Markdown</span><span>PDF</span>
        </div>
        <span class="format-tag">API data, config files</span>
      </div>
      <div class="format-card">
        <span class="format-label">CSV</span>
        <span class="format-arrow">→</span>
        <div class="format-targets">
          <span>JSON</span><span>Excel</span><span>XML</span><span>YAML</span><span>HTML</span><span>Markdown</span><span>PDF</span>
        </div>
        <span class="format-tag">Spreadsheets, DB exports</span>
      </div>
      <div class="format-card">
        <span class="format-label">Excel</span>
        <span class="format-arrow">→</span>
        <div class="format-targets">
          <span>JSON</span><span>CSV</span><span>XML</span><span>YAML</span><span>HTML</span><span>Markdown</span><span>PDF</span>
        </div>
        <span class="format-tag">Business reports, multi-sheet</span>
      </div>
      <div class="format-card">
        <span class="format-label">XML</span>
        <span class="format-arrow">→</span>
        <div class="format-targets">
          <span>JSON</span><span>CSV</span><span>Excel</span><span>YAML</span><span>HTML</span><span>Markdown</span><span>PDF</span>
        </div>
        <span class="format-tag">Legacy systems, web services</span>
      </div>
      <div class="format-card">
        <span class="format-label">YAML</span>
        <span class="format-arrow">→</span>
        <div class="format-targets">
          <span>JSON</span><span>CSV</span><span>Excel</span><span>XML</span><span>HTML</span><span>Markdown</span><span>PDF</span>
        </div>
        <span class="format-tag">Docker, Kubernetes, CI/CD</span>
      </div>
    </div>
  </section>

  <style>
    .use-cases, .format-table {
      padding: 48px 24px;
      max-width: 960px;
      margin: 0 auto;
    }
    .section-header {
      text-align: center;
      margin-bottom: 32px;
    }
    .section-header h2 {
      font-size: 24px;
      font-weight: 600;
      letter-spacing: -0.3px;
      margin-bottom: 8px;
      transition: color var(--transition);
    }
    .section-header p {
      color: var(--text-secondary);
      font-size: 15px;
      transition: color var(--transition);
    }

    .use-case-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
    }
    .use-case-card {
      padding: 24px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      transition: all var(--transition);
    }
    .use-case-card:hover {
      border-color: var(--primary);
    }
    .use-case-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: var(--primary);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }
    .use-case-card h3 {
      font-size: 16px;
      font-weight: 550;
      margin-bottom: 8px;
      color: var(--text);
      transition: color var(--transition);
    }
    .use-case-card p {
      font-size: 13px;
      line-height: 1.6;
      color: var(--text-secondary);
      margin: 0;
      transition: color var(--transition);
    }

    .format-grid {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .format-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      transition: all var(--transition);
    }
    .format-card:hover {
      border-color: var(--primary);
    }
    .format-label {
      font-weight: 600;
      font-size: 14px;
      color: var(--primary);
      min-width: 52px;
    }
    .format-arrow {
      color: var(--text-secondary);
      font-size: 16px;
      flex-shrink: 0;
    }
    .format-targets {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      flex: 1;
    }
    .format-targets span {
      font-size: 12px;
      padding: 3px 8px;
      border-radius: 6px;
      background: color-mix(in srgb, var(--border) 50%, transparent);
      color: var(--text-secondary);
      white-space: nowrap;
      transition: all var(--transition);
    }
    .format-tag {
      font-size: 11px;
      color: var(--text-secondary);
      padding: 3px 10px;
      border-radius: 100px;
      background: color-mix(in srgb, var(--border) 30%, transparent);
      white-space: nowrap;
      flex-shrink: 0;
    }

    @media (max-width: 640px) {
      .use-cases, .format-table { padding: 32px 16px; }
      .section-header h2 { font-size: 20px; }
      .use-case-grid { grid-template-columns: 1fr; }
      .format-card { flex-wrap: wrap; gap: 8px; }
      .format-tag { display: none; }
    }
  </style>
</BaseLayout>

<script>

</script>
