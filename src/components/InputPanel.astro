<div class="input-header">
  <div class="input-tabs" id="inputTabs">
    <button class="input-tab active" data-tab="paste">Paste</button>
    <button class="input-tab" data-tab="upload">Upload</button>
    <button class="input-tab" data-tab="url">URL</button>
  </div>
  <div class="input-actions">
    <button class="btn" id="loadExample">↻ Load Example</button>
    <button class="btn" id="clearBtn">✕ Clear</button>
    <button class="btn" id="validateBtn" style="color:var(--success);border-color:var(--success);">✓ Validate</button>
  </div>
</div>

<div class="privacy-notice">
  <span>🔒</span>
  <span>Processed entirely in your browser — no upload, no storage, no servers</span>
</div>

<textarea class="code-editor" id="codeEditor" placeholder="Paste your data here...">name,email,age,role,active
Sarah Chen,sarah.chen@acmecorp.com,34,Engineering Lead,true
Marcus Johnson,marcus.j@startup.io,28,Backend Developer,true
Priya Sharma,priya.sharma@dataflow.co,31,Data Analyst,false
Alex Kim,alex.kim@webster.tech,26,Frontend Developer,true
Yuki Tanaka,yuki.tanaka@bridge.jp,42,Product Manager,true
Omar Hassan,omar.h@niletech.com,29,DevOps Engineer,false
Elena Vasquez,elena.v@solara.io,37,UX Designer,true
Liam O'Brien,liam.ob@greenfield.ie,33,Full Stack Developer,true
Aisha Patel,aisha.p@quantum.ai,45,VP Engineering,true
David Park,david.p@nexus.health,39,Data Scientist,false</textarea>

<div class="convert-row">
  <button class="btn-convert" id="convertBtn">⟳ Convert to Excel (XLSX)</button>
  <button class="btn-ghost" id="swapBtn2">⇄ Swap</button>
  <button class="btn-ghost" id="resetBtn">↻ Reset</button>
</div>

<script>
  const editor = document.getElementById('codeEditor') as HTMLTextAreaElement;
  const tabs = document.querySelectorAll('#inputTabs .input-tab');
  const loadExample = document.getElementById('loadExample');
  const clearBtn = document.getElementById('clearBtn');
  const validateBtn = document.getElementById('validateBtn');
  const convertBtn = document.getElementById('convertBtn') as HTMLButtonElement;

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
    });
  });

  loadExample?.addEventListener('click', () => {
    editor.value = `name,email,age,role,active
Sarah Chen,sarah.chen@acmecorp.com,34,Engineering Lead,true
Marcus Johnson,marcus.j@startup.io,28,Backend Developer,true
Priya Sharma,priya.sharma@dataflow.co,31,Data Analyst,false
Alex Kim,alex.kim@webster.tech,26,Frontend Developer,true
Yuki Tanaka,yuki.tanaka@bridge.jp,42,Product Manager,true
Omar Hassan,omar.h@niletech.com,29,DevOps Engineer,false
Elena Vasquez,elena.v@solara.io,37,UX Designer,true
Liam O'Brien,liam.ob@greenfield.ie,33,Full Stack Developer,true
Aisha Patel,aisha.p@quantum.ai,45,VP Engineering,true
David Park,david.p@nexus.health,39,Data Scientist,false`;
  });

  clearBtn?.addEventListener('click', () => { editor.value = ''; editor.focus(); });

  validateBtn?.addEventListener('click', () => {
    try { JSON.parse(editor.value); alert('Valid JSON!'); }
    catch { try { JSON.parse('[' + editor.value.split('\n').map(l => '{' + l.split(',').map((_, i) => `"col${i}":"${_}"`).join(',') + '}').join(',') + ']'); alert('Looks like valid CSV data.'); }
    catch { alert('Could not auto-detect format. Make sure your data is valid.'); }}
  });
</script>

<style>
  .input-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 12px; flex-wrap: wrap; gap: 8px;
  }
  .input-tabs { display: flex; gap: 0; }
  .input-tab {
    padding: 6px 16px; font-size: 13px; font-weight: 500;
    background: var(--surface); border: 1px solid var(--border); color: var(--text-secondary);
    cursor: pointer; transition: all var(--transition); font-family: 'Inter', sans-serif;
  }
  .input-tab:first-child { border-radius: var(--radius-sm) 0 0 var(--radius-sm); }
  .input-tab:last-child { border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .input-tab:not(:last-child) { border-right: none; }
  .input-tab:hover { color: var(--text); background: var(--surface-hover); }
  .input-tab.active { background: var(--primary); border-color: var(--primary); color: #FFF; }
  .input-actions { display: flex; gap: 8px; }
  .btn {
    padding: 6px 14px; font-size: 13px; font-weight: 500; border-radius: var(--radius-sm);
    border: 1px solid var(--border); background: var(--surface); color: var(--text-secondary);
    cursor: pointer; transition: all var(--transition); font-family: 'Inter', sans-serif;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .btn:hover { background: var(--surface-hover); color: var(--text); border-color: var(--text-muted); }
  .privacy-notice {
    display: flex; align-items: center; gap: 6px; margin-bottom: 10px;
    padding: 8px 14px; border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--success) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--success) 15%, transparent);
    font-size: 12px; font-weight: 450; color: var(--success);
  }
  .code-editor {
    background: var(--code-bg); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 16px; min-height: 220px;
    font-family: 'JetBrains Mono', monospace; font-size: 13px; line-height: 1.7;
    color: var(--text); resize: vertical; width: 100%;
    transition: all var(--transition);
  }
  .code-editor:focus { outline: none; border-color: var(--border-focus); box-shadow: 0 0 0 3px var(--primary-glow); }
  .code-editor::placeholder { color: var(--text-muted); }
  .convert-row {
    display: flex; align-items: center; gap: 8px; margin-top: 16px; flex-wrap: wrap;
  }
  .btn-convert {
    padding: 10px 28px; font-size: 15px; font-weight: 600;
    border-radius: var(--radius); font-family: 'Inter', sans-serif; cursor: pointer;
    transition: all var(--transition); border: none;
    background: var(--primary); color: #FFF;
  }
  .btn-convert:hover { background: var(--primary-hover); transform: translateY(-1px); box-shadow: 0 4px 20px var(--primary-glow); }
  .btn-ghost {
    padding: 10px 20px; font-size: 14px; font-weight: 500;
    border-radius: var(--radius-sm); border: 1px solid var(--border);
    background: var(--surface); color: var(--text-secondary); cursor: pointer;
    font-family: 'Inter', sans-serif; transition: all var(--transition);
  }
  .btn-ghost:hover { border-color: var(--text-muted); color: var(--text); }
  @media (max-width: 640px) {
    .input-header { flex-direction: column; align-items: stretch; }
    .input-actions { margin-left: 0; justify-content: flex-end; }
    .convert-row { flex-direction: column; }
    .btn-convert, .btn-ghost { width: 100%; text-align: center; }
  }
</style>
