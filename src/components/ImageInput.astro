---
import { defaultLocale, isLocale } from '../i18n/languages';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/languages';

export interface Props {
  locale?: Locale;
  defaultTo?: string;
}

const locale: Locale = Astro.props.locale && isLocale(Astro.props.locale) ? Astro.props.locale : defaultLocale;
const t = ui[locale].image;
const defaultTo: string = Astro.props.defaultTo || 'JPG';
---

<div class="image-input">
  <div class="privacy-notice">
    <span>🔒</span>
    <span>{t.privacy}</span>
  </div>

  <div id="imgDropZone" class="drop-zone" role="button" tabindex="0" aria-label={t.dragDropText}>
    <div class="drop-inner">
      <div class="upload-icon">🖼️</div>
      <p class="drop-text">{t.dragDropText} <span class="browse-link" id="imgBrowseLink">{t.browse}</span></p>
      <p class="drop-hint">{t.supports}</p>
      <input type="file" id="imgFileInput" accept="image/*,.avif,.ico" hidden />
    </div>
  </div>

  <div id="imgControls" class="controls" style="display:none">
    <div class="control-group">
      <label class="control-label" for="imgTarget">{t.target}</label>
      <div class="format-group">
        <select id="imgTarget" class="format-select">
          <option value="PNG" selected={defaultTo === 'PNG'}>PNG</option>
          <option value="JPG" selected={defaultTo === 'JPG'}>JPG</option>
          <option value="WEBP" selected={defaultTo === 'WEBP'}>WEBP</option>
        </select>
        <span class="format-select-arrow">▼</span>
      </div>
    </div>

    <div class="control-group" id="qualityGroup">
      <label class="control-label" for="imgQuality">{t.quality}: <span id="qualityValue">85</span>%</label>
      <input type="range" id="imgQuality" class="quality-range" min="10" max="100" value="85" />
    </div>

    <button class="btn-convert" id="imgConvertBtn">⟳ {t.convert}</button>
  </div>

  <div id="imgValidation" class="validation-badge" style="display:none"></div>
</div>

<script>
  import { convertImage } from '../lib/converters/image';
  import type { ImageFormat, ConvertedImage } from '../lib/converters/image';

  const dropZone = document.getElementById('imgDropZone')!;
  const browseLink = document.getElementById('imgBrowseLink')!;
  const fileInput = document.getElementById('imgFileInput') as HTMLInputElement;
  const controls = document.getElementById('imgControls')!;
  const targetSelect = document.getElementById('imgTarget') as HTMLSelectElement;
  const qualityInput = document.getElementById('imgQuality') as HTMLInputElement;
  const qualityValue = document.getElementById('qualityValue')!;
  const qualityGroup = document.getElementById('qualityGroup')!;
  const convertBtn = document.getElementById('imgConvertBtn') as HTMLButtonElement;
  const validation = document.getElementById('imgValidation')!;

  let currentFile: File | null = null;

  const lossyFormats = ['JPG', 'WEBP'];

  function showValidation(valid: boolean, message: string) {
    validation.style.display = 'flex';
    validation.className = `validation-badge ${valid ? 'valid' : 'invalid'}`;
    validation.textContent = (valid ? '✓ ' : '✗ ') + message;
  }

  function clearValidation() {
    validation.style.display = 'none';
  }

  function updateQualityVisibility() {
    qualityGroup.style.display = lossyFormats.includes(targetSelect.value) ? 'flex' : 'none';
  }

  function handleFile(file: File | null) {
    if (!file) return;
    if (!file.type.startsWith('image/')) {
      showValidation(false, 'Unsupported file type — please upload an image.');
      return;
    }
    if (file.size > 30 * 1024 * 1024) {
      showValidation(false, `File too large (${(file.size / 1024 / 1024).toFixed(1)} MB). Max: 30 MB`);
      return;
    }
    currentFile = file;
    clearValidation();
    controls.style.display = 'flex';
    window.dispatchEvent(new CustomEvent('image-selected', { detail: { name: file.name, size: file.size, type: file.type } }));
  }

  browseLink.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput.click();
  });

  dropZone.addEventListener('click', () => fileInput.click());

  dropZone.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });

  ['dragover', 'dragenter'].forEach((ev) => {
    dropZone.addEventListener(ev, (e) => {
      e.preventDefault();
      dropZone.classList.add('drag-over');
    });
  });

  ['dragleave', 'dragend'].forEach((ev) => {
    dropZone.addEventListener(ev, (e) => {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
    });
  });

  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    const file = e.dataTransfer?.files[0];
    if (file) handleFile(file);
  });

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) handleFile(file);
    fileInput.value = '';
  });

  targetSelect.addEventListener('change', () => {
    clearValidation();
    updateQualityVisibility();
  });

  qualityInput.addEventListener('input', () => {
    qualityValue.textContent = qualityInput.value;
  });

  window.addEventListener('image-reset', () => {
    currentFile = null;
    controls.style.display = 'none';
    clearValidation();
  });

  convertBtn.addEventListener('click', async () => {
    if (!currentFile) return;
    const target = targetSelect.value as ImageFormat;
    const quality = parseInt(qualityInput.value, 10) / 100;
    convertBtn.disabled = true;
    convertBtn.textContent = '⏳ Converting…';
    try {
      const result = await convertImage(currentFile, target, quality);
      window.dispatchEvent(new CustomEvent('image-converted', { detail: result }));
    } catch (e) {
      showValidation(false, (e as Error).message);
    } finally {
      convertBtn.disabled = false;
      convertBtn.textContent = '⟳ Convert';
    }
  });

  updateQualityVisibility();
</script>

<style>
  .image-input { max-width: 640px; margin: 0 auto; }
  .privacy-notice {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    margin-bottom: 12px; padding: 8px 14px; border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--success) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--success) 15%, transparent);
    font-size: 12px; font-weight: 450; color: var(--success); text-align: center;
  }
  .drop-zone {
    border: 2px dashed var(--border); border-radius: var(--radius);
    padding: 48px 24px; cursor: pointer; text-align: center;
    background: var(--surface); transition: all var(--transition); outline: none;
  }
  .drop-zone:hover { border-color: var(--text-muted); }
  .drop-zone.drag-over { border-color: var(--primary); background: var(--primary-glow); }
  .drop-zone:focus-visible { border-color: var(--border-focus); box-shadow: 0 0 0 3px var(--primary-glow); }
  .upload-icon { font-size: 40px; margin-bottom: 10px; }
  .drop-text { font-size: 15px; color: var(--text-secondary); margin-bottom: 6px; }
  .browse-link { color: var(--primary); cursor: pointer; font-weight: 500; text-decoration: underline; }
  .drop-hint { font-size: 12px; color: var(--text-muted); }

  .controls {
    margin-top: 16px; display: flex; align-items: center; justify-content: center;
    gap: 20px; flex-wrap: wrap; padding: 16px;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); transition: all var(--transition);
  }
  .control-group { display: flex; flex-direction: column; gap: 6px; }
  .control-label { font-size: 12px; color: var(--text-secondary); font-weight: 500; }
  .format-group { position: relative; }
  .format-select {
    appearance: none; -webkit-appearance: none;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 8px 34px 8px 14px;
    font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500;
    color: var(--text); cursor: pointer; min-width: 120px;
    transition: all var(--transition);
  }
  .format-select:hover { border-color: var(--text-muted); }
  .format-select:focus { outline: none; border-color: var(--border-focus); box-shadow: 0 0 0 3px var(--primary-glow); }
  .format-select-arrow {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    pointer-events: none; color: var(--text-muted); font-size: 11px;
  }
  .quality-range { width: 180px; accent-color: var(--primary); cursor: pointer; }
  .btn-convert {
    padding: 10px 26px; font-size: 15px; font-weight: 600; border-radius: var(--radius);
    font-family: 'Inter', sans-serif; cursor: pointer; border: none; align-self: flex-end;
    background: var(--primary); color: #FFF; transition: all var(--transition);
  }
  .btn-convert:hover:not(:disabled) { background: var(--primary-hover); transform: translateY(-1px); box-shadow: 0 4px 20px var(--primary-glow); }
  .btn-convert:disabled { opacity: 0.6; cursor: default; }
  .validation-badge {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    margin-top: 10px; padding: 8px 14px; border-radius: var(--radius-sm);
    font-size: 12px; font-weight: 500;
  }
  .validation-badge.valid {
    background: color-mix(in srgb, var(--success) 10%, transparent);
    color: var(--success); border: 1px solid color-mix(in srgb, var(--success) 20%, transparent);
  }
  .validation-badge.invalid {
    background: color-mix(in srgb, var(--error) 10%, transparent);
    color: var(--error); border: 1px solid color-mix(in srgb, var(--error) 20%, transparent);
  }
  @media (max-width: 640px) {
    .controls { flex-direction: column; align-items: stretch; text-align: center; }
    .control-group { align-items: center; }
    .btn-convert { align-self: center; width: 100%; }
  }
</style>
