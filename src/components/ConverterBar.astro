---
const formats = ['JSON', 'CSV', 'Excel (XLSX)', 'XML', 'YAML', 'HTML Table', 'Markdown'];
---

<div class="converter-bar">
  <div class="format-group">
    <select class="format-select" id="from-format">
      {formats.map(f => (
        <option value={f} selected={f === 'CSV'}>{f}</option>
      ))}
    </select>
    <span class="format-select-arrow">▼</span>
  </div>

  <div class="bridge">
    <span class="bridge-line"></span>
    <button class="swap-btn" id="swapBtn" title="Swap formats">⇄</button>
    <span class="bridge-line"></span>
  </div>

  <div class="format-group">
    <select class="format-select" id="to-format">
      {formats.map(f => (
        <option value={f} selected={f === 'Excel (XLSX)'}>{f}</option>
      ))}
    </select>
    <span class="format-select-arrow">▼</span>
  </div>
</div>

<script>
  const from = document.getElementById('from-format') as HTMLSelectElement;
  const to = document.getElementById('to-format') as HTMLSelectElement;
  const swap = document.getElementById('swapBtn');

  swap?.addEventListener('click', () => {
    const tmp = from.value;
    from.value = to.value;
    to.value = tmp;
  });
</script>

<style>
  .converter-bar {
    display: flex; align-items: center; justify-content: center; gap: 16px;
    margin-bottom: 32px; flex-wrap: wrap;
  }
  .format-group { position: relative; }
  .format-select {
    appearance: none; -webkit-appearance: none;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 10px 40px 10px 16px;
    font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500;
    color: var(--text); cursor: pointer; min-width: 140px;
    transition: all var(--transition);
  }
  .format-select:hover { border-color: var(--text-muted); }
  .format-select:focus { outline: none; border-color: var(--border-focus); box-shadow: 0 0 0 3px var(--primary-glow); }
  .format-select-arrow {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    pointer-events: none; color: var(--text-muted); font-size: 12px;
  }
  .swap-btn {
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--surface); border: 1px solid var(--border);
    color: var(--text-secondary); cursor: pointer; display: flex;
    align-items: center; justify-content: center; flex-shrink: 0;
    transition: all var(--transition); font-size: 18px;
  }
  .swap-btn:hover { background: var(--surface-hover); border-color: var(--primary); color: var(--primary); }
  .bridge {
    display: flex; align-items: center; gap: 6px; color: var(--text-muted); font-size: 13px;
  }
  .bridge-line {
    width: 32px; height: 2px; border-radius: 1px;
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    opacity: 0.5;
  }
  @media (max-width: 640px) {
    .converter-bar { flex-direction: column; gap: 10px; }
    .bridge { transform: rotate(90deg); }
    .format-select { min-width: 100%; }
  }
</style>
