---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConverterBar from './ConverterBar.astro';
import InputPanel from './InputPanel.astro';
import PreviewTable from './PreviewTable.astro';
import { homeContent } from '../i18n/content';
import type { Locale } from '../i18n/languages';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = homeContent[locale];

const icons: Record<string, string> = {
  api: '<polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/>',
  db: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>',
  config: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
  report: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
  sheet: '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>',
  json: '<polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/>',
  csv: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>',
  excel: '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>',
  xml: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
};
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  keywords={c.meta.keywords}
  locale={locale}
  path="/"
>
  <section class="hero">
    <h1 set:html={c.hero.h1} />
    {c.hero.descs.map((d) => <p class="hero-desc" set:html={d} />)}
    <div class="trust-badge">
      <span class="trust-icon">🔒</span>
      <span>{c.hero.trust}</span>
    </div>
  </section>

  <ConverterBar locale={locale} />
  <InputPanel locale={locale} />
  <PreviewTable locale={locale} />

  <section class="features">
    <h2>{c.features.heading}</h2>
    <div class="feature-grid">
      {c.features.cards.map((card) => (
        <a href={getRelativeLocaleUrl(locale, card.link)} class="feature-card">
          <h3 set:html={card.title} />
          <p set:html={card.desc} />
        </a>
      ))}
    </div>
  </section>

  <section class="how-it-works">
    <h2>{c.howItWorks.heading}</h2>
    <ol class="steps">
      {c.howItWorks.steps.map((step) => (
        <li><strong set:html={step.title} /> — <span set:html={step.desc} /></li>
      ))}
    </ol>
  </section>

  <section class="use-cases">
    <div class="section-header">
      <h2>{c.useCases.heading}</h2>
      <p>{c.useCases.sub}</p>
    </div>
    <div class="use-case-grid">
      {c.useCases.cards.map((card) => (
        <div class="use-case-card">
          <div class="use-case-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[card.icon]} />
          </div>
          <h3>{card.title}</h3>
          <p>{card.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="format-table">
    <div class="section-header">
      <h2>{c.formats.heading}</h2>
      <p>{c.formats.sub}</p>
    </div>
    <div class="format-grid">
      {c.formats.cards.map((card) => (
        <div class="format-card">
          <span class="format-label">{card.label}</span>
          <span class="format-arrow">→</span>
          <div class="format-targets">
            {card.targets.map((target) => <span>{target}</span>)}
          </div>
          <span class="format-tag">{card.tag}</span>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero { text-align: center; padding: 48px 0 24px; }
  .hero h1 {
    font-size: 32px; font-weight: 600; letter-spacing: -0.5px; margin-bottom: 8px;
    transition: color var(--transition);
  }
  .hero-desc {
    color: var(--text-secondary); font-size: 15px; max-width: 600px; margin: 0 auto 8px;
    transition: color var(--transition);
  }
  .hero-desc:last-of-type { margin-bottom: 0; }
  .trust-badge {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 16px; padding: 8px 18px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 100px; font-size: 13px; font-weight: 450;
    color: var(--text-secondary); transition: all var(--transition);
  }
  .trust-icon { font-size: 15px; }

  .features { padding: 40px 0; text-align: center; }
  .features h2 {
    font-size: 24px; font-weight: 600; letter-spacing: -0.3px;
    margin-bottom: 24px; transition: color var(--transition);
  }
  .feature-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px; max-width: 900px; margin: 0 auto;
  }
  a.feature-card {
    padding: 20px; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); text-align: left; display: block;
    text-decoration: none; color: inherit;
    transition: all var(--transition);
  }
  a.feature-card:hover { border-color: var(--primary); }
  .feature-card h3 {
    font-size: 16px; font-weight: 550; margin-bottom: 8px; color: var(--text);
  }
  .feature-card p {
    font-size: 13px; line-height: 1.6; color: var(--text-secondary); margin: 0;
  }

  .how-it-works {
    padding: 0 0 40px; max-width: 600px; margin: 0 auto;
  }
  .how-it-works h2 {
    font-size: 20px; font-weight: 600; text-align: center;
    margin-bottom: 20px; letter-spacing: -0.3px;
  }
  .steps {
    list-style: none; padding: 0; counter-reset: step;
  }
  .steps li {
    counter-increment: step; padding: 12px 16px 12px 48px;
    position: relative; font-size: 14px; color: var(--text-secondary);
    border-left: 2px solid var(--border); margin-left: 12px;
    transition: all var(--transition);
  }
  .steps li::before {
    content: counter(step); position: absolute; left: -12px;
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--primary); color: #fff; font-size: 12px; font-weight: 600;
    display: flex; align-items: center; justify-content: center;
  }
  .steps li:last-child { border-left-color: transparent; }
  .steps li strong { color: var(--text); }

  .use-cases, .format-table {
    padding: 48px 24px;
    max-width: 960px;
    margin: 0 auto;
  }
  .section-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .section-header h2 {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.3px;
    margin-bottom: 8px;
    transition: color var(--transition);
  }
  .section-header p {
    color: var(--text-secondary);
    font-size: 15px;
    transition: color var(--transition);
  }

  .use-case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .use-case-card {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: all var(--transition);
  }
  .use-case-card:hover {
    border-color: var(--primary);
  }
  .use-case-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }
  .use-case-card h3 {
    font-size: 16px;
    font-weight: 550;
    margin-bottom: 8px;
    color: var(--text);
    transition: color var(--transition);
  }
  .use-case-card p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
    transition: color var(--transition);
  }

  .format-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .format-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: all var(--transition);
  }
  .format-card:hover {
    border-color: var(--primary);
  }
  .format-label {
    font-weight: 600;
    font-size: 14px;
    color: var(--primary);
    min-width: 52px;
  }
  .format-arrow {
    color: var(--text-secondary);
    font-size: 16px;
    flex-shrink: 0;
  }
  .format-targets {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    flex: 1;
  }
  .format-targets span {
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--border) 50%, transparent);
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all var(--transition);
  }
  .format-tag {
    font-size: 11px;
    color: var(--text-secondary);
    padding: 3px 10px;
    border-radius: 100px;
    background: color-mix(in srgb, var(--border) 30%, transparent);
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .hero h1 { font-size: 24px; }
    .trust-badge { font-size: 12px; padding: 6px 14px; }
    .features h2 { font-size: 20px; }
    .feature-grid { grid-template-columns: 1fr; }
    .how-it-works h2 { font-size: 18px; }
    .use-cases, .format-table { padding: 32px 16px; }
    .section-header h2 { font-size: 20px; }
    .use-case-grid { grid-template-columns: 1fr; }
    .format-card { flex-wrap: wrap; gap: 8px; }
    .format-tag { display: none; }
  }
</style>
