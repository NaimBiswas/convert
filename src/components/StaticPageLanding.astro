---
import BaseLayout from '../layouts/BaseLayout.astro';
import HtmlBlocks from './HtmlBlocks.astro';
import { staticPages } from '../i18n/pages';
import { localizeHrefs, localizeBreadcrumbs, stripHtml } from '../i18n/pages/utils';
import type { Locale } from '../i18n/languages';
import type { StaticPageSlug } from '../i18n/pages';

export interface Props {
  locale: Locale;
  slug: StaticPageSlug;
  path: string;
}

const { locale, slug, path } = Astro.props;
const c = staticPages[locale][slug];
const crumbs = localizeBreadcrumbs(locale, c.breadcrumbs);
const lh = (html: string) => localizeHrefs(locale, html);
const siteUrl = 'https://metadataconverter.com';

let schema: object;
if (slug === 'about') {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Data Converter',
    url: siteUrl,
    description: c.meta.description,
    author: { '@type': 'Person', name: 'Naim Biswas', url: 'https://github.com/NaimBiswas' },
  };
} else if (slug === 'contact') {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: c.h1,
    description: c.meta.description,
    mainEntity: {
      '@type': 'Person',
      name: 'Naim Biswas',
      email: c.email,
      contactType: 'technical support',
    },
  };
} else if (slug === 'faq') {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    name: c.h1,
    mainEntity: c.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: stripHtml(f.a) },
    })),
  };
} else if (slug === 'docs') {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    name: c.h1,
    description: c.meta.description,
    applicationCategory: 'UtilityApplication',
    author: { '@type': 'Person', name: 'Naim Biswas' },
  };
} else {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: c.h1,
    description: c.meta.description,
    about: { '@type': 'Thing', name: c.h1 },
  };
}
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  keywords={c.meta.keywords}
  locale={locale}
  path={path}
  breadcrumbs={crumbs}
  schema={schema}
>
  <main class="static-page">
    {slug === 'faq' && (
      <Fragment>
        <h1>{c.h1}</h1>
        <div class="faq-list">
          {c.faqs.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <div class="faq-answer" set:html={lh(item.a)} />
            </details>
          ))}
        </div>
      </Fragment>
    )}

    {slug === 'about' && (
      <Fragment>
        <h1>{c.h1}</h1>
        {c.paragraphs.map((p) => <p set:html={lh(p)} />)}
      </Fragment>
    )}

    {slug === 'contact' && (
      <Fragment>
        <h1>{c.h1}</h1>
        <p set:html={lh(c.intro)} />
        <p>
          <a href={c.buttonUrl} target="_blank" rel="noopener" class="contact-btn">{c.buttonLabel}</a>
        </p>
        <p set:html={lh(c.emailIntro)} />
        <p set:html={lh(c.bugHint)} />
      </Fragment>
    )}

    {slug === 'docs' && (
      <Fragment>
        <h1>{c.h1}</h1>
        {c.blocks.map((block) => (
          <Fragment>
            {block.type === 'cards' && (
              <Fragment>
                <h2>{block.heading}</h2>
                <div class="grid">
                  {block.cards.map((card) => (
                    <div class="card">
                      <h3>{card.h3}</h3>
                      <p set:html={lh(card.p)} />
                    </div>
                  ))}
                </div>
              </Fragment>
            )}
            {block.type === 'shortcuts' && (
              <Fragment>
                <h2>{block.heading}</h2>
                <table class="shortcuts">
                  <thead>
                    <tr>
                      <th>{block.columns.shortcut}</th>
                      <th>{block.columns.action}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {block.rows.map((row) => (
                      <tr>
                        <td><kbd>{row.shortcut}</kbd></td>
                        <td>{row.action}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </Fragment>
            )}
            {block.type === 'section' && (
              <Fragment>
                <h2>{block.heading}</h2>
                <HtmlBlocks blocks={block.blocks} locale={locale} />
              </Fragment>
            )}
          </Fragment>
        ))}
      </Fragment>
    )}

    {(slug === 'privacy' || slug === 'terms' || slug === 'cookies') && (
      <Fragment>
        <h1>{c.h1}</h1>
        {c.lastUpdated && <em>{c.lastUpdated}</em>}
        {c.intro && <p set:html={lh(c.intro)} />}
        {c.sections.map((section) => (
          <Fragment>
            <h2>{section.heading}</h2>
            <HtmlBlocks blocks={section.blocks} locale={locale} />
          </Fragment>
        ))}
      </Fragment>
    )}
  </main>
</BaseLayout>

<style>
  .static-page { max-width: 720px; margin: 40px auto; padding: 0 16px; }
  .static-page h1 {
    font-size: 28px; font-weight: 600; margin-bottom: 8px; letter-spacing: -0.5px;
  }
  .static-page em {
    font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 24px;
  }
  .static-page h2 {
    font-size: 20px; font-weight: 550; margin: 32px 0 12px; color: var(--text);
  }
  .static-page h3 {
    font-size: 14px; font-weight: 550; margin-bottom: 6px; color: var(--text);
  }
  .static-page p {
    font-size: 15px; line-height: 1.7; color: var(--text-secondary); margin-bottom: 12px;
  }
  .static-page ul, .static-page ol { padding-left: 20px; margin-bottom: 12px; }
  .static-page li { font-size: 14px; line-height: 1.8; color: var(--text-secondary); }
  .static-page a { color: var(--primary); text-decoration: none; }
  .static-page a:hover { text-decoration: underline; }
  .static-page code {
    font-family: 'JetBrains Mono', monospace; font-size: 13px;
    background: var(--code-bg); padding: 1px 5px; border-radius: 4px;
  }
  .static-page kbd {
    font-family: 'JetBrains Mono', monospace; font-size: 12px; padding: 2px 7px;
    border-radius: 5px; border: 1px solid var(--border); background: var(--surface);
    color: var(--text);
  }

  .contact-btn {
    display: inline-block; margin: 8px 0; padding: 10px 24px;
    border-radius: var(--radius); background: var(--primary); color: #fff !important;
    font-size: 15px; font-weight: 500; text-decoration: none !important;
    transition: background var(--transition);
  }
  .contact-btn:hover { background: var(--primary-hover); }

  .faq-list { display: flex; flex-direction: column; gap: 8px; }
  .faq-item {
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); overflow: hidden;
    transition: border-color var(--transition), background var(--transition);
  }
  .faq-item[open] { border-color: var(--primary); }
  .faq-item summary {
    padding: 16px 20px; font-size: 15px; font-weight: 500; color: var(--text);
    cursor: pointer; list-style: none; display: flex; align-items: center;
    justify-content: space-between; user-select: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+'; font-size: 18px; color: var(--text-muted);
    transition: transform var(--transition), color var(--transition); line-height: 1;
  }
  .faq-item[open] summary::after { transform: rotate(45deg); color: var(--primary); }
  .faq-item summary:hover { background: var(--surface-hover); }
  .faq-item[open] summary { border-bottom: 1px solid var(--border); }
  .faq-answer { padding: 16px 20px; font-size: 14px; line-height: 1.7; color: var(--text-secondary); }

  .grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px; margin-bottom: 16px;
  }
  .card {
    padding: 16px; border: 1px solid var(--border);
    border-radius: var(--radius); background: var(--surface);
  }
  .card p { font-size: 13px; color: var(--text-muted); margin: 0; line-height: 1.5; }

  .shortcuts { width: 100%; border-collapse: collapse; font-size: 14px; }
  .shortcuts th {
    text-align: left; padding: 8px 12px; font-weight: 500; font-size: 12px;
    text-transform: uppercase; letter-spacing: 0.4px; color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }
  .shortcuts td { padding: 8px 12px; border-bottom: 1px solid var(--border); color: var(--text-secondary); }

  @media (max-width: 640px) {
    .static-page { margin: 24px auto; }
    .static-page h1 { font-size: 24px; }
    .faq-item summary { padding: 14px 16px; font-size: 14px; }
    .faq-answer { padding: 14px 16px; font-size: 13px; }
  }
</style>
