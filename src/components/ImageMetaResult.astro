---
import { defaultLocale, isLocale } from '../i18n/languages';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/languages';

export interface Props {
  locale?: Locale;
  mode: 'view' | 'remove';
}

const locale: Locale = Astro.props.locale && isLocale(Astro.props.locale) ? Astro.props.locale : defaultLocale;
const t = ui[locale].image;
const mode = Astro.props.mode;
---

<div id="metaResultRoot" style="display:none" data-mode={mode}
  data-t-metadata={t.metadata}
  data-t-gps={t.gps}
  data-t-loading="Reading metadata…"
  data-t-nometadata={t.noMetadata}
  data-t-nothing={t.nothingFound}
  data-t-removebtn={t.removeBtn}
  data-t-foundmeta={t.foundMeta}
  data-t-field={t.tableField}
  data-t-value={t.tableValue}
>
  <div class="section-label">{t.result}</div>

  <div class="preview-strip">
    <div class="preview-image-wrap">
      <img id="metaPreviewImg" alt="" />
    </div>
    <div class="preview-info">
      <div class="info-grid">
        <div class="info-cell">
          <span class="info-label">{t.fileName}</span>
          <span class="info-value" id="metaFileName">—</span>
        </div>
        <div class="info-cell">
          <span class="info-label">{t.outputFormat}</span>
          <span class="info-value" id="metaFormat">—</span>
        </div>
        <div class="info-cell">
          <span class="info-label">{t.dimensions}</span>
          <span class="info-value" id="metaDimensions">—</span>
        </div>
        <div class="info-cell">
          <span class="info-label">{t.fileSize}</span>
          <span class="info-value" id="metaFileSize">—</span>
        </div>
      </div>
    </div>
  </div>

  <div id="metaLoading" class="meta-loading" style="display:none">
    <span class="spinner"></span>
    <span id="metaLoadingText">⏳</span>
  </div>

  <div id="metaMessage" class="meta-message" style="display:none"></div>

  <div id="metaRemoveStep" class="meta-panel" style="display:none">
    <div id="metaFoundList"></div>
    <button class="btn-primary" id="metaRemoveBtn">🗑 {t.removeBtn}</button>
  </div>

  <div id="metaViewer" style="display:none">
    <div id="metaGroups"></div>
    <div id="metaEmpty" class="meta-empty" style="display:none">🖼️ {t.noMetadata}</div>
    <div class="meta-actions">
      <button class="btn-download primary" id="metaExportBtn">⬇ {t.exportJson}</button>
      <button class="btn-ghost" id="metaResetBtn">↻ {t.tryAnother}</button>
    </div>
  </div>

  <div id="metaCleanResult" style="display:none">
    <div class="info-grid">
      <div class="info-cell">
        <span class="info-label">{t.fileName}</span>
        <span class="info-value" id="cleanFileName">—</span>
      </div>
      <div class="info-cell">
        <span class="info-label">{t.fileSize}</span>
        <span class="info-value" id="cleanFileSize">—</span>
      </div>
      <div class="info-cell">
        <span class="info-label">{t.removedGroups}</span>
        <span class="info-value" id="cleanRemoved">—</span>
      </div>
    </div>
    <div class="meta-actions">
      <button class="btn-download primary" id="metaCleanDownload">⬇ {t.downloadClean}</button>
      <button class="btn-ghost" id="metaResetBtn2">↻ {t.tryAnother}</button>
    </div>
  </div>
</div>

<script>
  import { readImageMetadata, stripMetadata, detectRemovable } from '../lib/converters/metadata';
  import type { ImageMetaInfo, StrippedImage } from '../lib/converters/metadata';
  import { downloadBlob } from '../lib/exportUtils';

  const root = document.getElementById('metaResultRoot')!;
  const mode = root.dataset.mode as 'view' | 'remove';
  const tStr = (key: string) => root.dataset[key] || '';
  const LABELS = {
    metadata: tStr('tMetadata') || 'Metadata',
    gps: tStr('tGps') || 'GPS',
    loading: tStr('tLoading') || 'Reading metadata…',
    noMetadata: tStr('tNoMetadata') || '',
    nothing: tStr('tNothing') || '',
    removeBtn: tStr('tRemovebtn') || 'Remove metadata & download',
    foundMeta: tStr('tFoundmeta') || 'Found hidden metadata',
    tableField: tStr('tTableField') || 'Property',
    tableValue: tStr('tTableValue') || 'Value',
  };

  const previewImg = document.getElementById('metaPreviewImg') as HTMLImageElement;
  const fileName = document.getElementById('metaFileName')!;
  const formatEl = document.getElementById('metaFormat')!;
  const dimensions = document.getElementById('metaDimensions')!;
  const fileSize = document.getElementById('metaFileSize')!;
  const loading = document.getElementById('metaLoading')!;
  const loadingText = document.getElementById('metaLoadingText')!;
  const message = document.getElementById('metaMessage')!;
  const removeStep = document.getElementById('metaRemoveStep')!;
  const foundList = document.getElementById('metaFoundList')!;
  const removeBtn = document.getElementById('metaRemoveBtn') as HTMLButtonElement;
  const viewer = document.getElementById('metaViewer')!;
  const groupsEl = document.getElementById('metaGroups')!;
  const emptyEl = document.getElementById('metaEmpty')!;
  const exportBtn = document.getElementById('metaExportBtn')!;
  const resetBtn = document.getElementById('metaResetBtn')!;
  const cleanResult = document.getElementById('metaCleanResult')!;
  const cleanFileName = document.getElementById('cleanFileName')!;
  const cleanFileSize = document.getElementById('cleanFileSize')!;
  const cleanRemoved = document.getElementById('cleanRemoved')!;
  const cleanDownload = document.getElementById('metaCleanDownload') as HTMLButtonElement;
  const resetBtn2 = document.getElementById('metaResetBtn2')!;

  let sourceUrl: string | null = null;
  let cleanUrl: string | null = null;
  let currentFile: File | null = null;
  let info: ImageMetaInfo | null = null;

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / 1024 / 1024).toFixed(2)} MB`;
  }

  function revokeAll() {
    if (sourceUrl) { URL.revokeObjectURL(sourceUrl); sourceUrl = null; }
    if (cleanUrl) { URL.revokeObjectURL(cleanUrl); cleanUrl = null; }
  }

  function reset() {
    revokeAll();
    currentFile = null;
    info = null;
    root.style.display = 'none';
    message.style.display = 'none';
    loading.style.display = 'none';
    removeStep.style.display = 'none';
    viewer.style.display = 'none';
    cleanResult.style.display = 'none';
    window.dispatchEvent(new CustomEvent('meta-reset'));
  }

  function showMessage(kind: 'ok' | 'info' | 'err', text: string) {
    message.style.display = 'block';
    message.className = `meta-message ${kind}`;
    message.textContent = text;
  }

  function setInfo(name: string, format: string, dims: string, size: string) {
    fileName.textContent = name;
    formatEl.textContent = format;
    dimensions.textContent = dims;
    fileSize.textContent = size;
  }

  function setPreview(url: string) {
    previewImg.src = url;
    previewImg.alt = '';
  }

  async function readDimensions(file: File): Promise<string> {
    let width: number | null = null;
    let height: number | null = null;
    try {
      const bmp = await createImageBitmap(file);
      width = bmp.width;
      height = bmp.height;
      bmp.close();
    } catch {
      // fall back to metadata reader below
    }
    if (width && height) return `${width} × ${height} px`;
    try {
      const parsed = await readImageMetadata(file);
      if (parsed.width && parsed.height) return `${parsed.width} × ${parsed.height} px`;
    } catch {
      // ignore
    }
    return '—';
  }

  const handleView = async (file: File) => {
    loading.style.display = 'flex';
    loadingText.textContent = LABELS.loading;
    viewer.style.display = 'none';
    removeStep.style.display = 'none';
    cleanResult.style.display = 'none';
    message.style.display = 'none';
    try {
      info = await readImageMetadata(file);
      const dims = await readDimensions(file);
      setInfo(file.name, info.format, dims, formatBytes(info.size));
      setPreview(sourceUrl || '');
      loading.style.display = 'none';
      if (info.groups.length === 0) {
        groupsEl.textContent = '';
        emptyEl.style.display = 'block';
      } else {
        emptyEl.style.display = 'none';
        renderGroups(info.groups);
      }
      viewer.style.display = 'block';
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (e) {
      loading.style.display = 'none';
      showMessage('err', (e as Error).message);
    }
  };

  const handleRemove = async (file: File) => {
    loading.style.display = 'flex';
    loadingText.textContent = LABELS.loading;
    removeStep.style.display = 'none';
    cleanResult.style.display = 'none';
    viewer.style.display = 'none';
    message.style.display = 'none';
    try {
      const bytes = new Uint8Array(await file.arrayBuffer());
      const found = detectRemovable(bytes);
      const dims = await readDimensions(file);
      setInfo(file.name, bytes.length ? '' : '', dims, formatBytes(file.size));
      formatEl.textContent = file.type.replace(/^image\//, '').toUpperCase();
      setPreview(sourceUrl || '');
      loading.style.display = 'none';
      foundList.textContent = '';
      if (found.length === 0) {
        showMessage('ok', LABELS.nothing);
        return;
      }
      const label = document.createElement('div');
      label.className = 'found-label';
      label.textContent = LABELS.foundMeta;
      foundList.appendChild(label);
      const chips = document.createElement('div');
      chips.className = 'found-chips';
      for (const name of found) {
        const chip = document.createElement('span');
        chip.className = 'found-chip';
        chip.textContent = name;
        chips.appendChild(chip);
      }
      foundList.appendChild(chips);
      removeStep.style.display = 'block';
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (e) {
      loading.style.display = 'none';
      showMessage('err', (e as Error).message);
    }
  };

  function renderGroups(groups: ImageMetaInfo['groups']) {
    groupsEl.textContent = '';
    for (const group of groups) {
      const block = document.createElement('div');
      block.className = 'meta-group';
      const head = document.createElement('h3');
      const heading = group.name === 'GPS' ? LABELS.gps : group.name === 'Metadata' ? LABELS.metadata : group.name;
      head.textContent = heading;
      if (group.name === 'GPS') head.classList.add('gps-heading');
      block.appendChild(head);
      const table = document.createElement('table');
      table.className = 'meta-table';
      const thead = document.createElement('thead');
      const headRow = document.createElement('tr');
      const thKey = document.createElement('th');
      thKey.textContent = LABELS.tableField;
      const thVal = document.createElement('th');
      thVal.textContent = LABELS.tableValue;
      headRow.appendChild(thKey);
      headRow.appendChild(thVal);
      thead.appendChild(headRow);
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      for (const row of group.rows) {
        const tr = document.createElement('tr');
        const k = document.createElement('th');
        k.scope = 'row';
        k.className = 'meta-row-key';
        k.textContent = row.key;
        const v = document.createElement('td');
        v.className = 'meta-row-value';
        v.textContent = row.value;
        tr.appendChild(k);
        tr.appendChild(v);
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      block.appendChild(table);
      groupsEl.appendChild(block);
    }
  }

  window.addEventListener('meta-file-selected', (e) => {
    const file = (e as CustomEvent).detail?.file as File | undefined;
    if (!file) return;
    revokeAll();
    currentFile = file;
    sourceUrl = URL.createObjectURL(file);
    root.style.display = 'block';
    if (mode === 'view') {
      handleView(file);
    } else {
      handleRemove(file);
    }
  });

  removeBtn.addEventListener('click', async () => {
    if (!currentFile) return;
    removeBtn.disabled = true;
    removeBtn.textContent = '⏳ …';
    try {
      const result: StrippedImage = await stripMetadata(currentFile);
      cleanUrl = result.objectUrl;
      if (sourceUrl) { URL.revokeObjectURL(sourceUrl); sourceUrl = null; }
      setPreview(cleanUrl);
      const base = currentFile.name.replace(/\.[^.]+$/, '');
      cleanFileName.textContent = `${base}_clean.${result.extension}`;
      cleanFileSize.textContent = `${formatBytes(result.beforeSize)} → ${formatBytes(result.afterSize)}`;
      cleanRemoved.textContent = result.removed.join(', ') || '—';
      cleanDownload.onclick = () => {
        downloadBlob(result.blob, `${base}_clean.${result.extension}`, result.blob.type);
      };
      removeStep.style.display = 'none';
      cleanResult.style.display = 'block';
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      showMessage('err', (err as Error).message);
    } finally {
      removeBtn.disabled = false;
      removeBtn.textContent = `🗑 ${LABELS.removeBtn}`;
    }
  });

  exportBtn.addEventListener('click', () => {
    if (!info) return;
    const payload = {
      filename: info.filename,
      format: info.format,
      size: info.size,
      width: info.width,
      height: info.height,
      generatedAt: new Date().toISOString(),
      metadata: Object.fromEntries(info.groups.map((g) => [g.name, Object.fromEntries(g.rows.map((r) => [r.key, r.value]))])),
    };
    const base = info.filename.replace(/\.[^.]+$/, '');
    downloadBlob(JSON.stringify(payload, null, 2), `${base}-metadata.json`, 'application/json');
  });

  resetBtn.addEventListener('click', reset);
  resetBtn2.addEventListener('click', reset);
  window.addEventListener('meta-reset', () => {
    revokeAll();
  });
</script>

<style>
  .section-label {
    display: flex; align-items: center; gap: 8px; margin: 36px 0 12px;
    font-size: 13px; font-weight: 500; color: var(--text-secondary);
    text-transform: uppercase; letter-spacing: 0.5px;
    transition: color var(--transition);
  }
  .section-label::after {
    content: ''; flex: 1; height: 1px; background: var(--border);
    transition: background var(--transition);
  }
  .preview-strip {
    display: flex; gap: 20px; padding: 20px;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); transition: all var(--transition);
  }
  .preview-image-wrap {
    flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center;
    background: var(--code-bg); border-radius: var(--radius-sm);
    border: 1px solid var(--border); padding: 16px; overflow: hidden;
  }
  .preview-image-wrap img {
    max-width: 100%; max-height: 260px; object-fit: contain; border-radius: 4px;
  }
  .preview-info { width: 260px; flex-shrink: 0; display: flex; flex-direction: column; gap: 12px; justify-content: center; }
  .info-grid { display: flex; flex-direction: column; gap: 8px; }
  .info-cell { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .info-label { font-size: 12px; color: var(--text-muted); }
  .info-value { font-size: 13px; font-weight: 550; color: var(--text); }

  .meta-loading {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    margin-top: 16px; padding: 18px; font-size: 14px; color: var(--text-secondary);
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
  }
  .spinner {
    width: 18px; height: 18px; border-radius: 50%;
    border: 2px solid var(--border); border-top-color: var(--primary);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .meta-message {
    margin-top: 16px; padding: 12px 16px; border-radius: var(--radius-sm); font-size: 13px;
  }
  .meta-message.ok { background: color-mix(in srgb, var(--success) 10%, transparent); color: var(--success); border: 1px solid color-mix(in srgb, var(--success) 20%, transparent); }
  .meta-message.info { background: color-mix(in srgb, var(--primary) 8%, transparent); color: var(--primary); border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent); }
  .meta-message.err { background: color-mix(in srgb, var(--error) 10%, transparent); color: var(--error); border: 1px solid color-mix(in srgb, var(--error) 20%, transparent); }

  .meta-panel {
    margin-top: 16px; padding: 18px; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); display: flex; flex-direction: column; gap: 14px; align-items: center;
  }
  .found-label { font-size: 13px; color: var(--text-secondary); text-align: center; }
  .found-chips { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
  .found-chip {
    font-size: 12px; padding: 4px 10px; border-radius: 100px;
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    color: var(--primary); border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
  }
  .btn-primary {
    padding: 10px 24px; font-size: 14px; font-weight: 600; border-radius: var(--radius);
    background: var(--primary); color: #FFF; border: none; cursor: pointer; font-family: 'Inter', sans-serif;
    transition: all var(--transition);
  }
  .btn-primary:hover:not(:disabled) { background: var(--primary-hover); transform: translateY(-1px); box-shadow: 0 4px 20px var(--primary-glow); }
  .btn-primary:disabled { opacity: 0.6; cursor: default; }
  .btn-download {
    padding: 9px 18px; font-size: 13px; font-weight: 500; border-radius: var(--radius-sm);
    border: 1px solid var(--border); background: var(--surface); color: var(--text-secondary);
    cursor: pointer; font-family: 'Inter', sans-serif; display: inline-flex; align-items: center; gap: 6px;
    transition: all var(--transition);
  }
  .btn-download.primary { border-color: var(--primary); color: var(--primary); }
  .btn-download.primary:hover { background: var(--primary-glow); }
  .btn-ghost {
    padding: 9px 16px; font-size: 13px; font-weight: 500; border-radius: var(--radius-sm);
    border: 1px solid var(--border); background: var(--surface); color: var(--text-secondary);
    cursor: pointer; font-family: 'Inter', sans-serif; transition: all var(--transition);
  }
  .btn-ghost:hover { border-color: var(--text-muted); color: var(--text); }

  .meta-group { margin-top: 20px; }
  .meta-group h3 {
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
    color: var(--text-muted); margin-bottom: 8px;
  }
  .meta-group h3.gps-heading { color: var(--primary); }
  .meta-table {
    width: 100%; border-collapse: collapse; font-size: 13px;
    border: 1px solid var(--border); border-radius: var(--radius-sm);
    background: var(--surface); overflow: hidden; table-layout: fixed;
  }
  .meta-table thead th {
    text-align: left; font-weight: 600; color: var(--text-secondary);
    background: var(--surface-hover); padding: 9px 12px;
    border-bottom: 1px solid var(--border); font-size: 12px; text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .meta-table tbody tr { border-bottom: 1px solid var(--border); }
  .meta-table tbody tr:last-child { border-bottom: none; }
  .meta-table tbody tr:hover { background: var(--surface-hover); }
  .meta-table tbody th {
    width: 40%; padding: 8px 12px; text-align: left; font-weight: 500;
    color: var(--text-secondary); word-break: break-word; vertical-align: top;
  }
  .meta-table tbody td {
    padding: 8px 12px; color: var(--text); word-break: break-word; font-weight: 450;
    vertical-align: top;
  }

  .meta-actions { display: flex; gap: 8px; margin-top: 20px; flex-wrap: wrap; }

  .meta-empty {
    margin-top: 20px; border: 1px dashed var(--border); border-radius: var(--radius-sm);
    background: var(--surface); color: var(--text-muted); text-align: center;
    padding: 32px 16px; font-size: 14px;
  }

  @media (max-width: 640px) {
    .preview-strip { flex-direction: column; }
    .preview-info { width: 100%; }
    .meta-table tbody th { width: 45%; }
  }
</style>