---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { blogContent } from '../i18n/pages';
import { localizeBreadcrumbs } from '../i18n/pages/utils';
import type { Locale } from '../i18n/languages';

export interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const c = blogContent[locale].index;
const crumbs = localizeBreadcrumbs(locale, c.breadcrumbs);
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  keywords={c.meta.keywords}
  locale={locale}
  path={path}
  breadcrumbs={crumbs}
>
  <main class="blog-index">
    <h1>{c.h1}</h1>
    <p class="blog-subtitle">{c.subtitle}</p>

    <div class="post-grid">
      {c.order.map((slug) => {
        const post = c.posts[slug];
        return (
          <article class="post-card">
            <a href={getRelativeLocaleUrl(locale, `/blog/${slug}`)} class="post-link">
              <img src={post.img} alt="" class="card-img" loading="lazy" />
              <div class="card-body">
                <h2>{post.title}</h2>
                <p class="card-desc">{post.desc}</p>
                <time datetime={post.dateISO}>{post.dateDisplay}</time>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>

<style>
  .blog-index { max-width: 720px; margin: 40px auto; padding: 0 16px; }
  .blog-index h1 { font-size: 28px; font-weight: 600; margin-bottom: 8px; letter-spacing: -0.5px; }
  .blog-subtitle { font-size: 15px; color: var(--text-secondary); margin-bottom: 32px; line-height: 1.6; }
  .post-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  .post-card {
    border: 1px solid var(--border); border-radius: 12px; overflow: hidden;
    background: var(--surface); transition: transform var(--transition), box-shadow var(--transition);
  }
  .post-card:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(0,0,0,0.08); }
  .post-link { text-decoration: none; display: flex; flex-direction: column; }
  .card-img { width: 100%; height: 200px; object-fit: cover; display: block; }
  .card-body { padding: 20px; }
  .card-body h2 { font-size: 18px; font-weight: 600; margin-bottom: 8px; color: var(--text); line-height: 1.4; transition: color var(--transition); }
  .post-card:hover .card-body h2 { color: var(--primary); }
  .card-desc { font-size: 14px; line-height: 1.6; color: var(--text-secondary); margin-bottom: 10px; }
  .card-body time { font-size: 12px; color: var(--text-secondary); opacity: 0.6; }
  @media (min-width: 640px) {
    .post-grid { grid-template-columns: 1fr 1fr 1fr; }
    .blog-index { max-width: 960px; }
  }
  @media (max-width: 640px) {
    .blog-index { margin: 24px auto; }
    .blog-index h1 { font-size: 24px; }
    .card-img { height: 180px; }
  }
</style>
